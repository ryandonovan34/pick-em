# ─────────────────────────────────────────────────────────────
# PickEm API — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# "development" enables /dev/* endpoints and auto-creates DB tables on startup.
# "production" hides /dev/* endpoints and requires Alembic for schema changes.
APP_ENV=development

# Full SQLAlchemy connection string.
# Local dev example: postgresql+psycopg2://postgres:postgres@localhost:5432/pickem
# Fly.io example:    postgresql+psycopg2://postgres:<password>@<host>:5432/pickem
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pickem

# Random secret used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Access tokens expire quickly; refresh tokens are long-lived and stored in the DB.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Odds API (The Odds API) ─────────────────────────────────
# Register at https://the-odds-api.com — the free tier is enough for development.
# Required in Phase 3+; leave blank during Phase 2 (mock data only).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com

# How old (in minutes) cached odds can be before a background re-fetch is triggered
# when an admin opens the slate-building screen.
ODDS_CACHE_TTL_MINUTES=120

# ── Firebase Cloud Messaging ────────────────────────────────
# Required in Phase 4. Use the HTTP v1 API (service account, not legacy server key).
# FCM_PROJECT_ID: found in Firebase console → Project settings → General
# FCM_SERVICE_ACCOUNT_JSON: path to the service account JSON file, OR the raw JSON string
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
